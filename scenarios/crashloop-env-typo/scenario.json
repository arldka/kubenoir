{
  "schemaVersion": 2,
  "chapter": 2,
  "id": "crashloop-env-typo",
  "title": "The Payments Pod That Wouldn't Stay Up",
  "briefing": "The payments-api deployment shipped 5 minutes ago and has been restarting ever since. The web tier is healthy. Find out why payments-api keeps dying and bring it back without touching the rest of the cluster.",
  "objective": "Find out why payments-api keeps dying and bring it back without touching the rest of the cluster.",
  "hints": [
    "Start with what the pods are doing: which command shows why a container keeps exiting?",
    "The application tells you what it is missing. Compare that name, letter by letter, with the environment the Deployment actually sets.",
    "Pods cannot be edited in place; change the Deployment. The misspelled variable already holds the right value, so the new one needs exactly that value. 'kubectl set env' can add one variable and remove another in a single command."
  ],
  "success": {
    "stableSeconds": 15,
    "assert": [
      {
        "label": "payments-api is available again",
        "select": {
          "kind": "Deployment",
          "name": "payments-api"
        },
        "each": [
          {
            "path": "status.availableReplicas",
            "equals": 1
          }
        ]
      },
      {
        "label": "exactly one healthy payments-api pod is running",
        "select": {
          "kind": "Pod",
          "labels": {
            "app": "payments-api"
          }
        },
        "count": {
          "exactly": 1
        },
        "each": [
          {
            "path": "status.conditions[type=Ready].status",
            "equals": "True"
          }
        ]
      },
      {
        "label": "payments-api is configured with the real database URL",
        "select": {
          "kind": "Deployment",
          "name": "payments-api"
        },
        "each": [
          {
            "path": "spec.template.spec.containers[0].env[name=DATABASE_URL].value",
            "equals": "postgres://payments@postgres.default.svc.cluster.local:5432/payments"
          }
        ]
      }
    ],
    "constraints": [
      {
        "label": "the web deployment was left alone",
        "select": {
          "kind": "Deployment",
          "name": "web"
        },
        "each": [
          {
            "path": "metadata.generation",
            "equals": 1
          }
        ]
      },
      {
        "label": "no web pod was disturbed",
        "select": {
          "kind": "Pod",
          "labels": {
            "app": "web"
          }
        },
        "count": {
          "min": 2
        },
        "each": [
          {
            "path": "status.containerStatuses[0].restartCount",
            "equals": 0
          }
        ]
      },
      {
        "label": "payments-api was not deleted and recreated",
        "forbid": {
          "verb": "delete",
          "resource": "deployments",
          "name": "payments-api"
        }
      }
    ]
  },
  "findings": [
    {
      "id": "events",
      "clue": "The kubelet logged repeated BackOff events: a restart loop, not a one-off crash.",
      "when": {
        "anyOf": [
          {
            "command": {
              "verb": "get",
              "resource": "events"
            }
          },
          {
            "command": {
              "verb": "describe",
              "resource": "pods",
              "name": "payments-api*"
            }
          }
        ]
      }
    },
    {
      "id": "logs",
      "clue": "The app's last words: 'required environment variable DATABASE_URL is not set'.",
      "when": {
        "command": {
          "verb": "logs",
          "name": "payments-api*"
        }
      }
    },
    {
      "id": "environment",
      "clue": "The Deployment sets DATABSE_URL. The variable name is misspelled, and its value looks like the real database URL.",
      "when": {
        "anyOf": [
          {
            "command": {
              "verb": "describe",
              "name": "payments-api*"
            }
          },
          {
            "command": {
              "verb": "set-env",
              "name": "payments-api",
              "list": true
            }
          }
        ]
      }
    }
  ],
  "images": {
    "registry.example.com/payments-api:2.4.1": {
      "pullSeconds": 3,
      "app": "db-client@0.2.0",
      "config": {
        "name": "payments-api",
        "version": "2.4.1",
        "databaseUrlEnv": "DATABASE_URL",
        "portEnv": "PORT",
        "database": {
          "host": "postgres.default.svc.cluster.local",
          "port": 5432,
          "user": "payments",
          "name": "payments"
        }
      }
    },
    "nginx:1.27": {
      "app": "nginx@0.1.0"
    }
  },
  "cluster": {
    "startedAt": "2026-10-27T18:24:55Z",
    "now": "2026-10-27T18:30:00Z",
    "manifests": [
      "manifests/nodes.yaml",
      "manifests/workloads.yaml",
      "manifests/kube-system.yaml"
    ]
  }
}
