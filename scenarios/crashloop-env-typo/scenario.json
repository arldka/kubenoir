          "name": "payments-api",
          "namespace": "default",
          "labels": {
            "app": "payments-api"
          }
        },
        "spec": {
          "replicas": 1,
          "selector": {
            "matchLabels": {
              "app": "payments-api"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "payments-api"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "payments-api",
                  "image": "registry.example.com/payments-api:2.4.1",
                  "ports": [
                    {
                      "containerPort": 8080
                    }
                  ],
                  "env": [
                    {
                      "name": "PORT",
                      "value": "8080"
                    },
                    {
                      "name": "LOG_LEVEL",
                      "value": "info"
                    },
                    {
                      "name": "DATABSE_URL",
                      "value": "postgres://payments@postgres.default.svc.cluster.local:5432/payments"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    ],
    "pods": [
